# ==========================================================
#  Configuración de Modas Andrea
#  Copia este archivo como ".env" (instalar.bat lo hace solo)
# ==========================================================
# Clave secreta para firmar las sesiones. instalar.bat genera una aleatoria.
SECRET_KEY=
# Servidor (0.0.0.0 permite entrar desde otros dispositivos en la misma red)
HOST=0.0.0.0
PORT=5000
# Descuento máximo que puede dar un vendedor (%)
SELLER_MAX_DISCOUNT_PCT=10
# Un punto de lealtad por cada N pesos
POINTS_PER_PESOS=10
# Días de plazo de un apartado si no se elige fecha
LAYAWAY_DAYS=30
# Respaldos diarios a conservar (carpeta data/respaldos)
BACKUPS_TO_KEEP=15
# ---------- Acceso desde internet (acceso_remoto.bat) ----------
# Sin nada aquí se usa una dirección temporal https://....trycloudflare.com que cambia en cada inicio.
# Para una dirección fija: crea un túnel en tu cuenta de Cloudflare y pega aquí su token y tu dominio.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=
# Por internet se rechazan las contraseñas iniciales (admin123 y 12345). Déjalo en true.
BLOCK_DEFAULT_PASSWORDS_REMOTE=true
# ---------- Búsqueda con IA (botón "Buscar con IA" del escáner) ----------
# Clave de la API de Anthropic (console.anthropic.com). Sin clave, el botón no aparece.
# Cada consulta cuesta unos centavos de dólar; el límite mensual se cambia en Configuración.
ANTHROPIC_API_KEY=
# Modelo de Claude que se usa (por defecto claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# ---------- Tienda en línea ----------
# Sin nada aquí, la tienda se ve desde esta computadora: http://127.0.0.1:5000/tienda/ (y por internet con acceso_remoto.bat).
# Para que funcione aunque la PC esté apagada, crea una cuenta gratuita de Cloudflare y un token de API con permisos
# "Cloudflare Pages: Edit" y "Workers KV Storage: Edit"; pega aquí el ID de la cuenta y el token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Nombre del sitio: la tienda queda en https://NOMBRE.pages.dev
CLOUDFLARE_PAGES_PROJECT=modas-andrea-tienda
# Cuando compres el dominio, la dirección de la tienda (por ejemplo https://tienda.modasandrea.mx)
STORE_URL=
