# ==========================================================
#  Configuración de Modas Andrea
#  Copia este archivo como ".env" (instalar.bat lo hace solo)
# ==========================================================
# Clave secreta para firmar las sesiones. instalar.bat genera una aleatoria.
SECRET_KEY=
# Servidor (0.0.0.0 permite entrar desde otros dispositivos en la misma red)
HOST=0.0.0.0
PORT=5000
# Descuento máximo que puede dar un vendedor (%)
SELLER_MAX_DISCOUNT_PCT=10
# Un punto de lealtad por cada N pesos
POINTS_PER_PESOS=10
# Respaldos diarios a conservar (carpeta data/respaldos)
BACKUPS_TO_KEEP=15
